{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare Worker for the Astro site. Static pages are served straight from
  // the build output; requests for /keystatic and /api/keystatic run the
  // Worker script that the Cloudflare adapter builds.
  "name": "astro-keystatic-landing-page-links",
  "compatibility_date": "2026-11-09",
  "compatibility_flags": ["nodejs_compat"],
  // The server entry point the adapter builds into dist/.
  "main": "@astrojs/cloudflare/entrypoints/server",
  "assets": {
    // Prerendered pages and images from `npm run build`.
    "directory": "./dist",
    // Lets the Worker read those files when it needs to.
    "binding": "ASSETS"
  }
}
